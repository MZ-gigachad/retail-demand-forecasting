# Environment Variables Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to source control.

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Optional External Data APIs
WEATHER_API_KEY=
FRED_API_KEY=

# App Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# Random Seed
RANDOM_SEED=42
